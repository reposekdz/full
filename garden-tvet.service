[Unit]
Description=Garden TVET School Management API
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/garden-tvet/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=garden-tvet-api

[Install]
WantedBy=multi-user.target
