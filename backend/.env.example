# ========================================
# ULTRA-ADVANCED SMS CONFIGURATION
# ========================================

# Africa's Talking API Credentials
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=your_username_here

# SMS Sender ID (max 11 characters)
SMS_SENDER_ID=GARDEN_TVET

# School Information (for SMS messages)
SCHOOL_NAME=GARDEN TVET SCHOOL
SCHOOL_PHONE=+250 788 123 456
SCHOOL_EMAIL=info@garden.rw
SCHOOL_ADDRESS=Kigali, Rwanda

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=school_management

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# ========================================
# HOW TO GET AFRICA'S TALKING CREDENTIALS
# ========================================
# 1. Go to https://africastalking.com
# 2. Sign up for an account
# 3. Get your API Key from dashboard
# 4. Get your Username from dashboard
# 5. Add the credentials above
# 6. Restart the backend server
#
# Sandbox Mode (for testing):
# - Username: sandbox
# - API Key: Get from dashboard
# - Test numbers: Use your registered test numbers
#
# Production Mode:
# - Username: Your production username
# - API Key: Your production API key
# - Real numbers: Any valid phone number
# ========================================
