# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=school_management
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ========================================
# SMS CONFIGURATION (AFRICA'S TALKING - PRODUCTION)
# ========================================
# Get your credentials from: https://account.africastalking.com/
AFRICATALKING_API_KEY=atsk_your_production_api_key_here
AFRICATALKING_USERNAME=your_username_here
# For production, change from 'sandbox' to your actual username

# Alternative SMS Providers (if needed)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_PHONE_NUMBER=+250788123456

# ========================================
# EMAIL CONFIGURATION (PRODUCTION)
# ========================================
# Gmail Configuration (Use App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=school@gardentvet.ac.rw
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=Garden TVET School <school@gardentvet.ac.rw>

# Alternative Email Providers
# SENDGRID_API_KEY=your_sendgrid_api_key
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_DOMAIN=your_mailgun_domain

# ========================================
# NOTIFICATION SETTINGS
# ========================================
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Daily Reminder Times (24-hour format)
ATTENDANCE_REMINDER_TIME=08:00
ASSIGNMENT_REMINDER_TIME=18:00
EXAM_REMINDER_TIME=07:00
FEE_REMINDER_DAY=1
SPORTS_REMINDER_TIME=15:00

# ========================================
# PAYMENT GATEWAY (OPTIONAL)
# ========================================
# MTN Mobile Money
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_USER_ID=your_user_id
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key

# Airtel Money
AIRTEL_MONEY_CLIENT_ID=your_client_id
AIRTEL_MONEY_CLIENT_SECRET=your_client_secret

# ========================================
# CLOUD STORAGE (OPTIONAL)
# ========================================
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=school-management-files

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# SECURITY
# ========================================
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# ========================================
# LOGGING & MONITORING
# ========================================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# ========================================
# BACKUP CONFIGURATION
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# INSTRUCTIONS
# ========================================
# 1. Copy this file to .env in the backend directory
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to version control
# 4. Keep this file secure and backed up
# 5. Restart server after making changes
