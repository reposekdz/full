# Advanced Parent Portal Configuration
# Copy this file to .env and fill in your actual credentials

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=garden_tvet_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Mobile Money Payment Integration
# MTN Mobile Money Rwanda
PAYMENT_API_URL=https://api.mtn.com/collection/v1_0/requesttopay
PAYMENT_API_KEY=your_mtn_api_key_here
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key

# Airtel Money Rwanda
AIRTEL_API_URL=https://openapi.airtel.africa/merchant/v1/payments
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret

# SMS Notification Service (Africa's Talking)
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key_here
AFRICAS_TALKING_USERNAME=your_africas_talking_username
SMS_SENDER_ID=GARDEN_TVET
AFRICAS_TALKING_ENV=production

# Alternative SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+250XXXXXXXXX

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Garden TVET School

# Application Settings
PORT=3000
NODE_ENV=production
BASE_URL=https://yourdomain.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Session
SESSION_SECRET=your_session_secret_here

# Payment Webhook URLs
MTN_WEBHOOK_URL=https://yourdomain.com/api/webhooks/mtn
AIRTEL_WEBHOOK_URL=https://yourdomain.com/api/webhooks/airtel

# Admin Notifications
ADMIN_EMAIL=admin@gardentvet.rw
ADMIN_PHONE=+250788987830

# School Information
SCHOOL_NAME=Garden TVET School
SCHOOL_EMAIL=info@gardentvet.rw
SCHOOL_PHONE=+250788987830
SCHOOL_ADDRESS=Kigali, Rwanda
