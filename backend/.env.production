# PRODUCTION ENVIRONMENT CONFIGURATION
NODE_ENV=production
PORT=5000

# Database Configuration (Production)
DB_HOST=your_production_db_host
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_NAME=school_management
DB_PORT=3306

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRE=7d

# SMS Configuration (Africa's Talking - Production)
AFRICATALKING_API_KEY=your_production_api_key
AFRICATALKING_USERNAME=your_production_username
AFRICATALKING_SENDER_ID=GARDENTVET

# Email Configuration (Production)
EMAIL_SERVICE=gmail
EMAIL_USER=school@gardentvet.ac.rw
EMAIL_PASSWORD=your_production_email_password
EMAIL_FROM=Garden TVET School <school@gardentvet.ac.rw>

# Payment Gateway Configuration (Production)
REACT_APP_GT_BANK_API_KEY=your_production_gt_bank_key
REACT_APP_BPR_API_KEY=your_production_bpr_key
REACT_APP_EQUITY_API_KEY=your_production_equity_key
REACT_APP_MTN_API_KEY=your_production_mtn_key
REACT_APP_AIRTEL_API_KEY=your_production_airtel_key

# URLs
REACT_APP_API_URL=https://api.gardentvet.ac.rw/api
FRONTEND_URL=https://gardentvet.ac.rw

# Security
PAYMENT_WEBHOOK_SECRET=your_secure_webhook_secret
PAYMENT_ENCRYPTION_KEY=your_32_character_encryption_key

# Notifications
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Cron Jobs
ENABLE_CRON_JOBS=true
CRON_TIMEZONE=Africa/Kigali
