# Garden TVET School - Payment System Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# API Configuration
# ============================================
REACT_APP_API_URL=http://localhost:5000/api
JWT_SECRET=garden-tvet-super-secret-key-2024
FRONTEND_URL=http://localhost:3000

# ============================================
# GT Bank Rwanda Configuration
# ============================================
REACT_APP_GT_BANK_NAME=GT Bank Rwanda
REACT_APP_GT_BANK_ENABLED=false
REACT_APP_GT_BANK_API_URL=https://api.gtbank.rw/v1/payments
REACT_APP_GT_BANK_MERCHANT_ID=your_merchant_id
REACT_APP_GT_BANK_API_KEY=your_api_key

# ============================================
# Bank of Kigali (BPR) Configuration
# ============================================
REACT_APP_BPR_NAME=Bank of Kigali (BPR)
REACT_APP_BPR_ENABLED=false
REACT_APP_BPR_API_URL=https://api.bpr.rw/mobile/payments
REACT_APP_BPR_MERCHANT_ID=your_merchant_id
REACT_APP_BPR_API_KEY=your_api_key

# ============================================
# Equity Bank Rwanda Configuration
# ============================================
REACT_APP_EQUITY_NAME=Equity Bank Rwanda
REACT_APP_EQUITY_ENABLED=false
REACT_APP_EQUITY_API_URL=https://api.equitybank.rw/payments/v1
REACT_APP_EQUITY_MERCHANT_ID=your_merchant_id
REACT_APP_EQUITY_API_KEY=your_api_key

# ============================================
# MTN Mobile Money Configuration
# ============================================
REACT_APP_MTN_NAME=MTN Mobile Money
REACT_APP_MTN_ENABLED=false
REACT_APP_MTN_API_URL=https://api.mtn.rw/momo/v1
REACT_APP_MTN_COLLECTION_ID=your_collection_id
REACT_APP_MTN_API_KEY=your_api_key
REACT_APP_MTN_FEE_PERCENT=0.5

# ============================================
# Airtel Money Configuration
# ============================================
REACT_APP_AIRTEL_NAME=Airtel Money
REACT_APP_AIRTEL_ENABLED=false
REACT_APP_AIRTEL_API_URL=https://api.airtel.rw/money/v1
REACT_APP_AIRTEL_MERCHANT_ID=your_merchant_id
REACT_APP_AIRTEL_API_KEY=your_api_key
REACT_APP_AIRTEL_FEE_PERCENT=0.5

# ============================================
# Payment Settings
# ============================================
PAYMENT_GATEWAY_ENABLED=true
ALLOW_PARTIAL_PAYMENTS=true
PAYMENT_EXPIRY_HOURS=24
AUTO_RECEIPT_GENERATION=true
PAYMENT_NOTIFICATION_ENABLED=true
